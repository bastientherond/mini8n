upstream mini8n_api {
    server server:3000;
    keepalive 16;
}

server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    limit_conn conn 50;

    if ($request_method !~ ^(GET|HEAD|POST|PUT|PATCH|DELETE)$) {
        return 405;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- API -----------------------------------------------------------------
    location /api/auth/ {
        limit_req zone=auth burst=10 nodelay;
        include /tmp/snippets/security-headers.conf;
        proxy_pass http://mini8n_api;
        include /etc/nginx/templates/proxy.conf;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        include /tmp/snippets/security-headers.conf;
        proxy_pass http://mini8n_api;
        include /etc/nginx/templates/proxy.conf;
    }

    # --- Fichiers statiques ----------------------------------------------------
    # Ressources versionnées par Vite (nom avec hash) : cache long.
    location /assets/ {
        limit_except GET { deny all; }
        include /tmp/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location = /index.html {
        limit_except GET { deny all; }
        include /tmp/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Fichiers cachés (.env, .git…) : jamais servis.
    location ~ /\. {
        return 404;
    }

    location / {
        limit_except GET { deny all; }
        include /tmp/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
