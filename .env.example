# Copier en .env puis adapter.

# Origine publique exacte du site (anti-CSRF). Plusieurs valeurs séparées par des virgules.
PUBLIC_ORIGIN=http://192.168.0.99:8080
# Cookie de session Secure (+ préfixe __Host-) :
#   auto  = Secure uniquement quand le site est servi en HTTPS (profil tls) — recommandé ;
#   true  = toujours (Safari refuse alors la connexion sur http://localhost) ;
#   false = jamais (développement uniquement).
COOKIE_SECURE=auto
# Mettre à false une fois les comptes créés pour fermer les inscriptions.
ALLOW_REGISTRATION=true
SESSION_TTL_HOURS=168

# Exposition de l'interface (127.0.0.1 = machine locale uniquement).
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Origines que le nœud « Requête HTTP » peut appeler (directive CSP connect-src).
# Ex. restrictif : CSP_CONNECT_SRC=https://api.exemple.com https://jsonplaceholder.typicode.com
CSP_CONNECT_SRC=https:

# Profil TLS (docker compose --profile tls up -d) : nom de domaine public.
# SITE_ADDRESS=mini8n.exemple.com
# PUBLIC_ORIGIN=https://mini8n.exemple.com

# Exécution des workflows côté serveur (déclencheurs automatiques).
RUNNER_THREADS=4
EXECUTION_TIMEOUT_SECS=300
EXECUTIONS_RETENTION_DAYS=30

# Intégrations : hôtes ou réseaux privés joignables (bases de données internes…).
# Par défaut, seules les adresses publiques sont autorisées (protection SSRF).
# NETWORK_ALLOWLIST=erp.interne,10.20.0.0/16
# Services de la machine hôte (base locale, Mailpit…) : « localhost » y est redirigé
# vers host.docker.internal, qu'il faut autoriser :
NETWORK_ALLOWLIST=host.docker.internal,192.168.0.0/23
